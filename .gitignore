# Build output
/bin/
*.test
*.exe

# Coverage ARTIFACTS. Anchored to the root and named exactly, because the
# earlier rule was `coverage.*`, which silently swallowed scripts/coverage.py —
# the tool that produces them. A pattern broad enough to catch its own source
# is a pattern that will do it again.
*.out
/coverage.html
/coverage.svg

# The cache lath writes for compiled definitions
.lath/.cache/

# macOS
.DS_Store

# Stray binaries from `go build ./...` inside a module directory.
#
# The name is the directory's, so this matches whatever a module is called.
# The previous rule was /apps/*/cli, which stopped matching when the modules
# were flattened — and a 6.7 MB binary was committed before anyone noticed.
/cmd/*/lath
/kit/kit
/pipeline/pipeline
/steps/steps

# Python bytecode from the docs gate
__pycache__/
*.pyc

# BEGIN repolink (managed — do not edit)
/docsi
# END repolink
